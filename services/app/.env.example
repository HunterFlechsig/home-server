# Copy to .env on the App Guest. Do not commit .env.
# DOMAIN must be the Tailscale Serve HTTPS URL, including https://
DOMAIN=https://host1.REPLACE.ts.net
SIGNUPS_ALLOWED=true
# Argon2 hash from: docker run --rm -it vaultwarden/server:latest /vaultwarden hash
# If Compose interpolates dollars, double every $ in the hash.
ADMIN_TOKEN=
TZ=America/Los_Angeles
